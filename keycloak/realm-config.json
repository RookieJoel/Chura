{
  "id": "chura",
  "realm": "chura",
  "enabled": true,
  "loginTheme": "flowline",
  "accountTheme": "flowline",
  "adminTheme": "flowline",
  "emailTheme": "flowline",
  "clients": [
    {
      "clientId": "chura-auth-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    },
    {
      "clientId": "chura-backend",
      "name": "Chura backend (Admin API service account)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "chura-backend-dev-secret"
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "auditor",
        "description": "Auditor for chura",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "member",
        "description": "member for chura",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "users": [
    {
      "username": "jojo",
      "enabled": true,
      "email": "jojo@example.com",
      "firstName": "Suthanop",
      "lastName": "Channah",
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "auditor"
      ],
      "emailVerified": true
    },
    {
      "username": "tonnam",
      "enabled": true,
      "email": "tonnam@example.com",
      "firstName": "Jirapat",
      "lastName": "Dangkowkaew",
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "member"
      ],
      "emailVerified": true
    },
    {
      "username": "pim",
      "enabled": true,
      "email": "pim@example.com",
      "emailVerified": true,
      "firstName": "Pim",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "member"
      ]
    },
    {
      "username": "service-account-chura-backend",
      "enabled": true,
      "serviceAccountClientId": "chura-backend",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "query-groups"
        ]
      }
    }
