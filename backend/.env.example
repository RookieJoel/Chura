# Local development values. `make setup` (repo root) copies this to backend/.env.
# Postgres and MongoDB use native host services; RabbitMQ and Keycloak run in
# Docker and are reached through their published localhost ports.

DATABASE_URL=postgres://chura:admin@localhost:5432/chura?sslmode=disable
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=chura
FRONTEND_URL=http://localhost:3000

# Keycloak (required): token validation and the Admin API used for Project membership
KC_JWKS_ENDPOINT=http://localhost:8080/realms/chura/protocol/openid-connect/certs
KC_BASE_URL=http://localhost:8080
KC_REALM=chura
KC_BACKEND_CLIENT_ID=chura-backend
# Dev-only secret seeded by keycloak/realm-config.json. Never reuse outside local dev.
KC_BACKEND_CLIENT_SECRET=chura-backend-dev-secret

# Listen ports. Keycloak owns 8080 locally, so the API uses 8083 (same as the
# Docker setup). Change GRPC_PORT if something else on your machine holds 9000.
PORT=8083
GRPC_PORT=9000

RABBITMQ_URL=amqp://chura_dev:change_me_dev@rabbitmq:5672/
RABBITMQ_NOTIFICATION_QUEUE=chura-notifications
RABBITMQ_USER=chura_dev
RABBITMQ_PASSWORD=change_me_dev