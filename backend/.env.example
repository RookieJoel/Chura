# Copy this file to .env for local development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=chura

# Postgres, run via `docker compose up -d postgres` (see repo root docker-compose.yml)
DATABASE_URL=postgres://chura:chura@localhost:5434/chura?sslmode=disable

FRONTEND_URL=http://localhost:3000
PORT=8080

# gRPC listener. Change this if something else on your machine already owns 9000
# (e.g. `lsof -nP -iTCP:9000 -sTCP:LISTEN` shows a hit) — point Postman/grpcurl
# at the same port you set here.
GRPC_PORT=19000
