# Copy this file to .env for local MongoDB development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=chura

# Keycloak (required): token validation and the Admin API used for Project membership
KC_JWKS_ENDPOINT=http://localhost:8080/realms/chura/protocol/openid-connect/certs
KC_BASE_URL=http://localhost:8080
KC_REALM=chura
KC_BACKEND_CLIENT_ID=chura-backend
KC_BACKEND_CLIENT_SECRET=chura-backend-dev-secret

# Listen ports. PORT defaults to 8080, which Keycloak uses locally, so pick another.
# PORT=8083
# GRPC_PORT=9000
